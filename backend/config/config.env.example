# ShopSphere backend environment variables
PORT=5000
DB_LINK=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
NODE_ENV=production

JWT_SECRET=<long-random-secret>
JWT_EXPIRE=5d
COOKIE_EXPIRE=5

# Email / password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=<smtp-email>
SMTP_PASSWORD=<smtp-app-password>

# Cloudinary
CLOUDINARY_NAME=<cloudinary-cloud-name>
API_KEY=<cloudinary-api-key>
API_SECRET=<cloudinary-api-secret>

# Frontend URL (use the deployed ShopSphere URL if frontend is separate)
FRONTEND_URL=https://<your-shopsphere-domain>

